APP_DOMAIN=tka.example.com
POSTGRES_DB=tka
POSTGRES_USER=tka
JWT_ISSUER=tka-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
REDIS_MAXMEMORY=2gb
APP_RELEASE=2026.09.06-1
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_DEMO_EXAM_ID=30000000-0000-0000-0000-000000000001

# Set to true when backend runs behind nginx (default). Leave false when it is
# exposed directly so a forged X-Forwarded-For header cannot bypass rate limits.
TRUST_PROXY=true

# SMTP for "forgot password" emails and future transactional mail.
# Leave SMTP_HOST empty to disable outbound email entirely.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@example.com
SMTP_FROM=no-reply@example.com

# Optional published image tags. Defaults build local images.
BACKEND_IMAGE=tka/backend:local
WEB_IMAGE=tka/web:local
SIMPKB_CHECK_IMAGE=tka/simpkb-check:local

# SIMPKB teacher-verification microservice (Playwright/Chromium). Point
# SIMPKB_CHECK_URL at an internal address only; it is not exposed publicly.
SIMPKB_CHECK_INTERVAL=5m

# Override these paths when secrets/certificates live outside the repository.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
DATABASE_URL_FILE=./secrets/database_url.txt
REDIS_PASSWORD_FILE=./secrets/redis_password.txt
JWT_SECRET_FILE=./secrets/jwt_secret.txt
PAYMENT_WEBHOOK_SECRET_FILE=./secrets/payment_webhook_secret.txt
XENDIT_SECRET_KEY_FILE=./secrets/xendit_secret_key.txt
XENDIT_BASE_URL=https://api.xendit.co
# Optional; kosongkan bila Xendit menampilkan layar status default-nya.
# Contoh bila nanti ada halaman sukses/gagal di web: https://${APP_DOMAIN}/checkout/sukses
XENDIT_SUCCESS_REDIRECT_URL=
XENDIT_FAILURE_REDIRECT_URL=
SENTRY_DSN_FILE=./secrets/sentry_dsn.txt
SMTP_PASSWORD_FILE=./secrets/smtp_password.txt
TLS_CERT_FILE=./deploy/nginx/certs/fullchain.pem
TLS_KEY_FILE=./deploy/nginx/certs/privkey.pem

# PostgreSQL bawaan Compose hanya berada pada network internal dan memakai
# sslmode=disable. Untuk database managed/eksternal, ganti database_url.txt
# dengan sslmode=verify-full beserta CA yang diwajibkan penyedia.
