BACKUP_PROVIDER=s3
BACKUP_DB_MODE=compose
BACKUP_URI=s3://replace-me/tka-production
AWS_REGION=ap-southeast-1
AWS_KMS_KEY_ID=
DATABASE_URL_FILE=/opt/tka/secrets/database_url.txt
POSTGRES_DB=tka
POSTGRES_USER=tka
BACKUP_DIR=/var/backups/tka
BACKUP_LOCAL_RETENTION_DAYS=2
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/tka_backup.prom
PROD_ENV_FILE=/opt/tka/.env.production
LOG_DIR=/var/log/tka
LOG_RETENTION_DAYS=14
REDIS_EXAM_CLEANUP_GRACE_SECONDS=86400
REDIS_CLEANUP_MAX_KEYS=10000
